FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=pension-admin
ADMIN_PASSWORD=replace-with-a-unique-long-password
# Full Neon pooled PostgreSQL URI for Vercel. Do not commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
# Base URL for the PurvSMS prototype gateway. The app appends /api/send.
SMS_GATEWAY_URL=https://your-purvsms-gateway.vercel.app
# Keep true only for local Docker assessment/testing. Set false on Vercel.
EXPOSE_SMS_GATEWAY=false
